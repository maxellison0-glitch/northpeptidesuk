RESEND_API_KEY=re_your_resend_key_here
# Comma-separated list supported: every address gets the new-order notification.
ORDER_NOTIFY_EMAIL=orders@northpeptidesuk.com
ORDER_FROM_EMAIL="North Peptides UK <onboarding@resend.dev>"
BANK_ACCOUNT_NAME=your_account_name
BANK_SORT_CODE=00-00-00
BANK_ACCOUNT_NUMBER=00000000
# Orders page (/admin/) and the "How was your order?" email sent after dispatch.
# Each is a long random string (16+ characters). ORDER_DATA_KEY encrypts saved
# orders: set it once and never change it, or older orders can't be read.
ORDER_DATA_KEY=
ADMIN_KEY=
CRON_SECRET=
